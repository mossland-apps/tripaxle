# Content-hashed build output never changes under the same URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font files are versioned by hand; a year is still safe because a
# new subset would be published under a new filename.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Icons change rarely and are cheap to revalidate.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-mask.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800

# HTML must revalidate so a corrected guide reaches readers promptly.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
