---
import ArticleLayout from "../layouts/ArticleLayout.astro";
import QuickAnswer from "../components/QuickAnswer.astro";
import Callout from "../components/Callout.astro";
import { images } from "../lib/images";

const breadcrumbs = [
  { label: "Portugal Guide", href: "/portugal-guide" },
  { label: "Do You Need a Car?" },
];

const toc = [
  { label: "The one-question test", id: "test" },
  { label: "Trips where you don't need a car", id: "no-car" },
  { label: "Trips where a car is worth it", id: "car" },
  { label: "The in-between case: rent partway", id: "partway" },
  { label: "What a car costs beyond the rental", id: "true-cost" },
];

const related = [
  { label: "Where a Rental Car Is Most Useful in Portugal", href: "/where-a-rental-car-is-most-useful-in-portugal" },
  { label: "Driving in Portugal: What to Expect", href: "/driving-in-portugal-what-to-expect" },
  { label: "Portugal Car Rental Guide", href: "/portugal-guide" },
  { label: "Airport Rental Guides", href: "/airport-rental-guides" },
