---
import HubLayout from "../layouts/HubLayout.astro";
import { images } from "../lib/images";

const breadcrumbs = [
  { label: "Portugal Guide", href: "/portugal-guide" },
  { label: "Practical Guides" },
];

const guides = [
  { label: "Portugal toll roads for rental cars", href: "/portugal-toll-roads-for-rental-cars" },
  { label: "Can you rent a car in Portugal with a debit card?", href: "/portugal-car-rental-with-debit" },
  { label: "Manual vs automatic rental cars in Portugal", href: "/manual-vs-automatic-portugal" },
  { label: "What to photograph when picking up a rental car", href: "/what-to-photograph-rental-pickup" },
  { label: "What happens if your flight is late for pickup?", href: "/flight-late-for-car-rental-pickup" },
  { label: "After-hours car rental returns in Portugal", href: "/after-hours-car-rental-returns-portugal" },
  { label: "Gasóleo vs Gasolina: fuelling a rental car in Portugal", href: "/gasoleo-vs-gasolina-portugal" },
  { label: "Can you drive a Portugal rental car into Spain?", href: "/portugal-rental-car-into-spain" },
  { label: "Child seats and extras for rental cars in Portugal", href: "/child-seats-and-extras-portugal" },
];

const related = [
  { label: "Portugal Car Rental Guide", href: "/portugal-guide" },
  { label: "Booking Basics", href: "/booking-basics" },
  { label: "Airport Rental Guides", href: "/airport-rental-guides" },
];
---

<HubLayout
  title="Practical Portugal Car Rental Guides | TripAxle"
  description="Handle the real-world side of renting and driving in Portugal: toll roads, fuel labels, transmission choice, pickup preparation, and day-to-day rental friction."
  eyebrow="Practical Guides"
  heading="Practical Car Rental Guides for Smarter Trips"
  summary="The practical side of renting and driving in Portugal — toll roads, fuel, transmission, pickup preparation, and the details that cause stress if you do not plan for them."
  image={images.autumnForest}
  breadcrumbs={breadcrumbs}
  related={related}
>
  <h2>Guides in this section</h2>
  <ul class="guide-list">
    {guides.map((g) => (
      <li>
        {g.soon
          ? <span class="soon">{g.label} <em>— coming soon</em></span>
          : <a href={g.href}>{g.label}</a>}
      </li>
    ))}
  </ul>

  <h2>What this section covers</h2>
  <p>
    This section focuses on the practical side of renting and driving, not the
    contract language. These guides help with the everyday issues travelers run
    into before pickup, at pickup, and on the road.
  </p>
  <ul>
    <li>Toll roads, fuel labels, and transmission choice</li>
    <li>Pickup preparation and rental-day logistics</li>
    <li>Common friction points that can affect the trip in real life</li>
  </ul>

  <h2>How to use this hub</h2>
  <p>
    Start here if you already understand the basic booking terms and want help
    with the practical side of renting. If you still need help comparing
    insurance, deposits, holds, or rental terms before reserving, go back to
    <a href="/booking-basics">Booking Basics</a>. If your questions are specific
    to arrival logistics, use the
    <a href="/airport-rental-guides">airport rental guides</a>.
  </p>

  <style>
    .guide-list { margin-bottom: 2rem; }
    .guide-list li { margin: 0.4rem 0; }
    .guide-list a { font-weight: 600; }
    .guide-list .soon { color: var(--muted); }
    .guide-list .soon em { font-style: normal; font-size: 0.85rem; }
  </style>
</HubLayout>
