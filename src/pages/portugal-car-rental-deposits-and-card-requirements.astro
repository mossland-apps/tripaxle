      max-width: 760px;
    }

    .eyebrow {
      margin: 0 0 0.75rem;
      color: #2f6fed;
      font-size: 0.95rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    h1 {
