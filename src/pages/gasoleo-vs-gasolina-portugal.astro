const breadcrumbs = [
  { label: "Portugal Guide", href: "/portugal-guide/" },
  { label: "Practical Guides", href: "/practical-guides/" },
  { label: "Gasóleo vs Gasolina" },
];

const toc = [
  { label: "The two words that matter", id: "words" },
  { label: "How to know which your car takes", id: "which" },
  { label: "At the fuel station", id: "station" },
  { label: "Fuel policies and returning the car", id: "policy" },
  { label: "If you put in the wrong fuel", id: "misfuel" },
];

const related = [
  { label: "Portugal Car Rental Guide", href: "/portugal-guide/" },
  { label: "Manual vs Automatic Rental Cars in Portugal", href: "/manual-vs-automatic-portugal/" },
