---
import HubLayout from "../layouts/HubLayout.astro";
import { images } from "../lib/images";

const breadcrumbs = [
  { label: "Portugal Guide", href: "/portugal-guide" },
  { label: "Airport Rental Guides" },
];

const airports = [
  {
    name: "Lisbon Airport",
    href: "/lisbon-airport-car-rental",
    blurb:
      "A common pickup point for travelers leaving the city quickly — often unnecessary for city-only stays.",
  },
  {
    name: "Porto Airport",
    href: "/porto-airport-car-rental",
    blurb:
      "A practical start for the Douro, the Minho, and flexible multi-stop northern itineraries.",
  },
  {
    name: "Faro Airport",
    href: "/faro-airport-car-rental",
    blurb:
      "Usually the key pickup point for Algarve trips, beach stays, and southern driving routes.",
  },
];

const related = [
  { label: "Portugal Car Rental Guide", href: "/portugal-guide" },
  { label: "Booking Basics", href: "/booking-basics" },
  { label: "Practical Guides", href: "/practical-guides" },
];
---

<HubLayout
  title="Portugal Airport Rental Guides | TripAxle"
  description="Pickup locations, shuttle desks, returns, and common rental issues at Portugal's main airports — Lisbon, Porto, and Faro."
  eyebrow="Airport Rental Guides"
  heading="Airport Rental Guides for Portugal"
  summary="Where to collect a car at each major airport, how the shuttles and pickup work, and whether airport pickup beats collecting the car later."
  image={images.penaPalace}
  breadcrumbs={breadcrumbs}
  related={related}
>
  <div class="hub-cards">
    {airports.map((a) => (
      <article class="card">
        <h2>{a.name}</h2>
        <p>{a.blurb}</p>
        <a class="link-arrow" href={a.href}>{a.name} guide →</a>
      </article>
    ))}
  </div>

  <h2>What each airport guide covers</h2>
  <ul>
    <li>Where pickup desks or shuttle transfers are usually located</li>
    <li>Common pickup and return issues to watch for</li>
    <li>How each airport fits different trip plans and arrival times</li>
    <li>What to check before choosing airport pickup over city pickup</li>
  </ul>

  <h2>How to use this hub</h2>
  <p>
    Start with the airport that matches your arrival city. Then use the guide to
    decide whether airport pickup, city pickup, or no rental at all makes the
    most sense for your trip. If you are still deciding whether to rent at all,
    begin with the <a href="/portugal-guide">Portugal Car Rental Guide</a>.
  </p>

  <style>
    .hub-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin: 0 0 2.5rem;
    }
    @media (max-width: 860px) {
      .hub-cards { grid-template-columns: 1fr; }
    }
  </style>
</HubLayout>
