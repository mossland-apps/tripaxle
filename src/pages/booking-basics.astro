---
import HubLayout from "../layouts/HubLayout.astro";
import { images } from "../lib/images";

const breadcrumbs = [
  { label: "Portugal Guide", href: "/portugal-guide" },
  { label: "Booking Basics" },
];

const guides = [
  { label: "Portugal car rental insurance explained", href: "/portugal-car-rental-insurance" },
  { label: "Deposits and card requirements", href: "/portugal-car-rental-deposits-and-card-requirements" },
  { label: "Broker vs direct supplier for Portugal car rental", href: "/broker-vs-direct-supplier-portugal-car-rental", soon: true },
  { label: "How to read Portugal car rental terms before booking", href: "/how-to-read-portugal-car-rental-terms", soon: true },
  { label: "Common car rental mistakes in Portugal", href: "/common-car-rental-mistakes-portugal", soon: true },
];

const related = [
  { label: "Portugal Car Rental Guide", href: "/portugal-guide" },
  { label: "Airport Rental Guides", href: "/airport-rental-guides" },
  { label: "Practical Guides", href: "/practical-guides" },
];
---

<HubLayout
  title="Portugal Car Rental Booking Basics | TripAxle"
  description="The booking terms, policies, and requirements that matter before you reserve a rental car in Portugal: insurance, deposits, card rules, and how to read the terms."
  eyebrow="Booking Basics"
  heading="Booking Basics for Renting a Car in Portugal"
  summary="What the insurance options mean, what deposit and card rules to verify, and how to read the terms behind the headline price before you reserve."
  image={images.portugalRoad}
  breadcrumbs={breadcrumbs}
  related={related}
>
  <h2>Guides in this section</h2>
  <ul class="guide-list">
    {guides.map((g) => (
      <li>
        {g.soon
          ? <span class="soon">{g.label} <em>— coming soon</em></span>
          : <a href={g.href}>{g.label}</a>}
      </li>
    ))}
  </ul>

  <h2>What this section covers</h2>
  <p>
    This section focuses on the contract and policy side of renting a car in
    Portugal — before pickup, and before payment details turn into problems.
  </p>
  <ul>
    <li>How insurance and coverage options usually work before booking</li>
    <li>What to verify about deposits, holds, and accepted cards</li>
    <li>How rental terms can vary between offers</li>
    <li>What to double-check before finalising a reservation</li>
  </ul>

  <h2>How to use this hub</h2>
  <p>
    Start here if you want to understand the booking terms behind the headline
    price. These guides help you interpret what you are agreeing to before you
    reserve, so you can compare offers more clearly and avoid common mistakes.
  </p>
  <p>
    If you already know the booking terms and need help with tolls, transmission
    choice, fuel, or pickup logistics, continue to the
    <a href="/practical-guides">Practical Guides</a> or the airport rental guide
    that matches your trip.
  </p>

  <style>
    .guide-list { margin-bottom: 2rem; }
    .guide-list li { margin: 0.4rem 0; }
    .guide-list a { font-weight: 600; }
    .guide-list .soon { color: var(--muted); }
    .guide-list .soon em { font-style: normal; font-size: 0.85rem; }
  </style>
</HubLayout>
