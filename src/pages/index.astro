---
import Layout from "../layouts/Layout.astro";
import { images } from "../lib/images";

const hubs = [
  {
    title: "Portugal Guide",
    href: "/portugal-guide",
    body:
      "Start here to decide whether you need a car at all, and where in Portugal one actually adds value.",
    cta: "Read the Portugal guide",
  },
  {
    title: "Airport Rental Guides",
    href: "/airport-rental-guides",
    body:
      "Pickup desks, off-airport shuttles, documents, and leaving the airport — for Lisbon, Porto, and Faro.",
    cta: "See airport guides",
  },
  {
    title: "Booking Basics",
    href: "/booking-basics",
    body:
      "Insurance, deposits, card rules, and how to read rental terms before you reserve.",
    cta: "Learn booking basics",
  },
  {
    title: "Practical Guides",
    href: "/practical-guides",
    body:
      "Toll roads, fuel labels, manual vs automatic, and the day-to-day details of driving here.",
    cta: "See practical guides",
  },
];

const popular = [
  { label: "Do you need a car in Portugal?", href: "/do-you-need-a-car-in-portugal" },
  { label: "Portugal car rental insurance explained", href: "/portugal-car-rental-insurance" },
  { label: "Renting with a debit card", href: "/portugal-car-rental-with-debit" },
  { label: "Toll roads for rental cars", href: "/portugal-toll-roads-for-rental-cars" },
  { label: "Manual vs automatic in Portugal", href: "/manual-vs-automatic-portugal" },
  { label: "Lisbon Airport car rental guide", href: "/lisbon-airport-car-rental" },
];
---

<Layout
  title="TripAxle — Renting and Driving a Car in Portugal, Explained"
  description="Independent, practical guidance on renting and driving a car in Portugal: airports, insurance, deposits, tolls, and when a rental car is actually worth it."
>
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="eyebrow">Portugal car rental guide</p>
      <h1>Renting and driving a car in Portugal, explained clearly</h1>
      <p class="lede">
        Practical, independent guidance for English-speaking travelers — how
        airport pickup really works, what the insurance terms mean, how the
        tolls catch people out, and when a rental car is genuinely worth it.
      </p>
      <div class="home-hero__actions">
        <a class="button" href="/portugal-guide">Start with the Portugal guide</a>
        <a class="button button--ghost" href="/airport-rental-guides">Airport guides</a>
      </div>
    </div>
    <figure class="home-hero__figure">
      <img src={images.portoSkyline.src} alt={images.portoSkyline.alt} />
      <figcaption>{images.portoSkyline.credit}</figcaption>
    </figure>
  </section>

  <section class="home-hubs">
    <div class="home-hub-grid">
      {hubs.map((h) => (
        <article class="card home-hub">
          <h2>{h.title}</h2>
          <p>{h.body}</p>
          <a class="link-arrow" href={h.href}>{h.cta} →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="home-split">
    <div class="card">
      <h2>Popular questions</h2>
      <ul class="home-popular">
        {popular.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="card home-independent">
      <h2>An independent guide, not a booking site</h2>
      <p>
        TripAxle does not rank rental companies, sell reviews, or run a
        comparison engine. The aim is simpler: help you understand how renting
        and driving in Portugal actually works, so you can book with confidence
        wherever you book.
      </p>
      <a class="link-arrow" href="/about">How we research these guides →</a>
    </div>
  </section>

  <style>
    .home-hero {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2.5rem;
      align-items: center;
      margin: 1rem 0 3.5rem;
    }
    .home-hero__copy h1 { margin-bottom: 0.75rem; }
    .home-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.75rem;
    }
    .home-hero__figure {
      margin: 0;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-md);
    }
    .home-hero__figure img {
      display: block;
      width: 100%;
      height: clamp(260px, 34vw, 400px);
      object-fit: cover;
    }
    .home-hero__figure figcaption {
      font-size: 0.75rem;
      color: var(--muted);
      padding: 0.45rem 0.7rem;
      background: var(--surface);
    }

    .home-hubs { margin-bottom: 2.5rem; }
    .home-hub-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
    .home-hub { display: flex; flex-direction: column; }
    .home-hub p { color: var(--muted); flex: 1; }

    .home-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .home-popular { list-style: none; padding: 0; margin: 0; }
    .home-popular li { margin: 0.35rem 0; }
    .home-popular a { font-weight: 500; }
    .home-independent p { color: var(--muted); }

    @media (max-width: 900px) {
      .home-hero { grid-template-columns: 1fr; gap: 1.5rem; }
      .home-hub-grid { grid-template-columns: 1fr; }
      .home-split { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
