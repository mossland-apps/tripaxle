import QuickAnswer from "../components/QuickAnswer.astro";
import AtAGlance from "../components/AtAGlance.astro";
import Callout from "../components/Callout.astro";
import { images } from "../lib/images";

const breadcrumbs = [
  { label: "Portugal Guide", href: "/portugal-guide" },
  { label: "Where a Car Is Most Useful" },
];

const toc = [
  { label: "Algarve", id: "algarve" },
  { label: "Douro Valley & the north", id: "douro" },
  { label: "Alentejo", id: "alentejo" },
  { label: "Centro: Óbidos to Serra da Estrela", id: "centro" },
  { label: "Where a car adds little", id: "little-value" },
];

const glance = [
  { label: "Highest value", value: "Alentejo · rural Algarve · Douro hills" },
  { label: "Good value", value: "Centro (Óbidos, Nazaré, Tomar), Minho" },
  { label: "Low value", value: "Lisbon, Porto, single-town stays" },
  { label: "Signature drives", value: "N222 Douro · N2 spine · Monchique · Cabo de São Vicente" },
];

const related = [
  { label: "Do You Need a Car in Portugal?", href: "/do-you-need-a-car-in-portugal" },
  { label: "Driving in Portugal: What to Expect", href: "/driving-in-portugal-what-to-expect" },
  { label: "Faro Airport Car Rental Guide", href: "/faro-airport-car-rental" },
  { label: "Porto Airport Car Rental Guide", href: "/porto-airport-car-rental" },
