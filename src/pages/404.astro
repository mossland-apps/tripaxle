---
import Layout from "../layouts/Layout.astro";
import { nav } from "../config";
---

<Layout
  pageType="utility"
  noindex
  title="Page not found | TripAxle"
  description="That page could not be found. Head back to the TripAxle Portugal car rental guides."
>
  <section class="notfound">
    <p class="eyebrow">404</p>
    <h1>That page isn't here</h1>
    <p class="lede">
      The link may be old or mistyped. Everything on TripAxle starts from one of
      these:
    </p>

    <ul class="notfound__links">
      <li><a href="/">Home</a></li>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>

    <p>
      If you followed a link on this site to get here,
      <a href="/about/">let us know</a> so we can fix it.
    </p>
  </section>

  <style>
    .notfound { max-width: 44rem; padding: 1rem 0 2rem; }
    .notfound__links {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
    }
    .notfound__links a { font-weight: 600; }
  </style>
</Layout>
