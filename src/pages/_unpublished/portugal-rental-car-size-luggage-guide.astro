import QuickAnswer from "../components/QuickAnswer.astro";
import Callout from "../components/Callout.astro";
import { images } from "../lib/images";
import { cite } from "../lib/sources";

const breadcrumbs = [
  { label: "Portugal Guide", href: "/portugal-guide/" },
  { label: "Booking Basics", href: "/booking-basics/" },
  { label: "Car Size and Luggage" },
];

const toc = [
  { label: "Measure your luggage first", id: "measure" },
  { label: "What a category actually promises", id: "categories" },
  { label: "The size/road trade-off in Portugal", id: "trade-off" },
  { label: "Where child seats change the maths", id: "child-seats" },
  { label: "Transmission and size together", id: "transmission" },
