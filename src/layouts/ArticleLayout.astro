---
import { getImage } from 'astro:assets';
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import OnThisPage from '../components/OnThisPage.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import CommercialCTA from '../components/CommercialCTA.astro';
import Sources from '../components/Sources.astro';
import type { Source } from '../components/Sources.astro';
import { site } from '../config';
import { images, type HeroImage } from '../lib/images';
import { articleLd, canonicalPath, type Crumb, type PageType } from '../lib/seo';

interface TocItem { label: string; id: string }
interface RelatedLink { label: string; href: string }

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  summary?: string;
  published?: string;
  updated?: string | Date;
  /** Only for time-sensitive pages: the day the linked sources were read. */
  lastChecked?: string;
  image?: HeroImage;
  breadcrumbs: Crumb[];
  toc?: TocItem[];
  related?: RelatedLink[];
  relatedTitle?: string;
  cta?: { heading?: string; body?: string; destination?: string };
  /** Two to five authoritative links, time-sensitive pages only. */
  sources?: Source[];
  pageType?: PageType;
  noindex?: boolean;
}

const {
  title,
  description,
  eyebrow,
  summary,
  published,
  updated = site.defaultUpdated,
  lastChecked,
  image,
  breadcrumbs,
  toc = [],
  related = [],
  relatedTitle,
  cta,
  sources = [],
  pageType = 'guide',
  noindex = false,
} = Astro.props;

const headline = title.replace(/\s*\|\s*TripAxle\s*$/, '');
const path = canonicalPath(Astro.url.pathname);

// Same 1200x630 raster the social tags point at, so schema and Open Graph agree.
// Falls back to the site-wide default photo so every Article carries a
// representative image, and so schema and Open Graph always agree.
const socialSource = image ?? images.corkRoad;
const social = await getImage({
  src: socialSource.src,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 78,
});

const ld = articleLd({
  path,
  headline,
  description: description ?? summary,
  datePublished: published,
  dateModified: updated,
  image: {
    url: new URL(social.src, site.domain).href,
    width: 1200,
    height: 630,
    alt: socialSource.alt,
  },
});
---

<Layout
  title={title}
  description={description ?? summary}
  pageType={pageType}
  socialImage={image}
  noindex={noindex}
  jsonLd={[ld]}
>
  <Breadcrumbs items={breadcrumbs} />

  <div class="article-grid">
    <article class="prose">
      <PageHero
        eyebrow={eyebrow}
        title={headline}
        summary={summary}
        updated={updated}
        lastChecked={lastChecked}
        image={image}
      />

      <slot name="answer" />

      {toc.length > 0 && <OnThisPage items={toc} variant="inline" label="Contents" />}

      <slot />

      {cta && <CommercialCTA heading={cta.heading} body={cta.body} destination={cta.destination} />}
      {sources.length > 0 && <Sources sources={sources} />}
      {related.length > 0 && <RelatedGuides links={related} title={relatedTitle} />}
    </article>

    {toc.length > 0 && (
      <aside class="article-rail">
        <OnThisPage items={toc} />
      </aside>
    )}
  </div>
</Layout>
