---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { formatUpdated } from '../lib/text';

interface Props {
  title: string;
  description?: string;
  heading: string;
  updated?: string | Date;
}
const { title, description, heading, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: heading }]} />
  <article class="prose legal">
    <h1>{heading}</h1>
    {updated && <p class="legal__updated">Last updated {formatUpdated(updated)}</p>}
    <slot />
  </article>
</Layout>
