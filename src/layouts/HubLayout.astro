---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import type { HeroImage } from '../lib/images';
import type { Crumb, PageType } from '../lib/seo';

interface RelatedLink { label: string; href: string }

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heading: string;
  summary?: string;
  image?: HeroImage;
  breadcrumbs: Crumb[];
  related?: RelatedLink[];
  relatedTitle?: string;
  pageType?: PageType;
}

const {
  title,
  description,
  eyebrow,
  heading,
  summary,
  image,
  breadcrumbs,
  related = [],
  relatedTitle,
  pageType = 'hub',
} = Astro.props;
---

<Layout
  title={title}
  description={description ?? summary}
  pageType={pageType}
  socialImage={image}
>
  <Breadcrumbs items={breadcrumbs} />
  <div class="hub prose">
    <PageHero eyebrow={eyebrow} title={heading} summary={summary} image={image} />
    <slot />
    {related.length > 0 && <RelatedGuides links={related} title={relatedTitle} />}
  </div>
</Layout>
