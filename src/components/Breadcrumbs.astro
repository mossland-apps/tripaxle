---
import { breadcrumbLd, canonicalPath, graph, type Crumb } from '../lib/seo';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

// Every trail starts at Home, both visually and in the structured data.
const trail: Crumb[] =
  items[0]?.href === '/' ? [...items] : [{ label: 'Home', href: '/' }, ...items];

const jsonLd = graph(breadcrumbLd(trail));
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {trail.map((c, i) => (
      <li>
        {c.href && i < trail.length - 1 ? (
          <a href={canonicalPath(c.href)}>{c.label}</a>
        ) : (
          <span aria-current="page">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
