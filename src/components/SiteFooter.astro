---
import { site, nav, popularGuides, siteNav } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <p class="site-footer__brand">{site.name}</p>
        <p>{site.tagline}</p>
        <p>
          Independent guidance for English-speaking travelers — no rankings, no
          manufactured reviews, no booking engine. Just how renting and driving
          a car in Portugal actually works.
        </p>
      </div>

      <nav class="site-footer__col" aria-labelledby="footer-guides">
        <p class="site-footer__label" id="footer-guides">Guides</p>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav class="site-footer__col" aria-labelledby="footer-popular">
        <p class="site-footer__label" id="footer-popular">Popular</p>
        <ul>
          {popularGuides.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav class="site-footer__col" aria-labelledby="footer-tripaxle">
        <p class="site-footer__label" id="footer-tripaxle">TripAxle</p>
        <ul>
          {siteNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.name} · {site.tagline}</p>
      <p>
        {site.showCommercialCTA ? (
          <>
            TripAxle carries advertising and affiliate links, kept separate from
            the travel guidance. Booking through an affiliate link may earn us a
            commission at no extra cost to you. See our
            <a href="/affiliate-disclosure/">Affiliate Disclosure</a>.
          </>
        ) : (
          <>
            Editorially independent — not owned by, or acting for, any rental
            company, airport, or booking site. See the
            <a href="/affiliate-disclosure/">Affiliate Disclosure</a> and
            <a href="/disclaimer/">Disclaimer</a>.
          </>
        )}
      </p>
    </div>
  </div>
</footer>
