---
interface Item {
  label: string;
  id: string;
}
interface Props {
  items: Item[];
  /** `rail` is the sticky sidebar copy; `inline` sits early in the article. */
  variant?: 'rail' | 'inline';
  label?: string;
}
const { items, variant = 'rail', label = 'On this page' } = Astro.props;
---

<nav
  class={variant === 'inline' ? 'on-this-page on-this-page--inline' : 'on-this-page'}
  aria-label={label}
>
  <p class="on-this-page__label">{label}</p>
  <ol>
    {items.map((it) => (
      <li><a href={`#${it.id}`}>{it.label}</a></li>
    ))}
  </ol>
</nav>
